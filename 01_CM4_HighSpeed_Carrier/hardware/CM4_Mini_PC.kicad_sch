	(text "CM4 MINI-DESKTOP PC — MASTER SYSTEM ARCHITECTURE"
		(exclude_from_sim no)
		(at 25 27 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "11111111-0001-0001-0001-000000000001")
	)
	(text "4-Layer Controlled-Impedance Carrier Board for Raspberry Pi Compute Module 4 | High-Speed PCIe M.2 NVMe Edition"
		(exclude_from_sim no)
		(at 25 33 0)
		(effects
			(font
				(size 1.5 1.5)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "11111111-0001-0001-0001-000000000002")
	)
	(text "• Primary Input: 5V / 3A DC via USB-C Receptacle\n• Step-Down Buck: 3.3V / 5A (AP64351 Synchronous)\n• Protection: P-FET Reverse Polarity & TVS ESD Diode\n• Powers CM4 Module, USB Hub IC & M.2 NVMe SSD"
		(exclude_from_sim no)
		(at 28 50 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "11111111-0001-0001-0001-000000000003")
	)
	(text "• Mezzanine 2: Hirose DF40C-100DS-0.4V (Pins 101-200)\n• Display Output: Standard Full-Size HDMI 0 Receptacle\n• Signal Integrity: 100-Ohm Differential TMDS Pairs\n• Protection: Low-Capacitance TVS Clamping Diodes\n• Level Shifter: 3.3V to 5V DDC I2C Translator"
		(exclude_from_sim no)
		(at 113 50 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "11111111-0001-0001-0001-000000000004")
	)
	(text "• Hub IC: Microchip USB2514B 4-Port Controller\n• Downstream Ports: 4x USB 2.0 Type-A (Dual Stacked)\n• Clock Reference: 24.000 MHz Crystal Oscillator\n• Port Protection: AP2191 High-Side Power Switches\n• Interconnect: 90-Ohm Differential USB Pairs"
		(exclude_from_sim no)
		(at 198 50 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "11111111-0001-0001-0001-000000000005")
	)
	(text "• RTC Controller: NXP PCF85063AT (I2C Interface)\n• Timekeeping Crystal: 32.768 kHz Quartz Oscillator\n• Battery Backup: CR1220 Coin Cell + BAT54C Diode\n• Preserves System Wall-Clock Time When Powered Off"
		(exclude_from_sim no)
		(at 28 102 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "11111111-0001-0001-0001-000000000006")
	)
	(text "• Mezzanine 1: Hirose DF40C-100DS-0.4V (Pins 1-100)\n• Network Interface: 10/100/1000 Gigabit RJ45 MagJack\n• Fallback Storage: MicroSD Socket (CM4 Lite OS Boot)\n• Power Management: SD_PWR_ON High-Side Switch\n• Visual Diagnostics: PWR (Red) & ACT (Green) LEDs"
		(exclude_from_sim no)
		(at 113 102 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "11111111-0001-0001-0001-000000000007")
	)
	(text "• Interface: Single PCIe Gen 2.0 Lane (5.0 Gbps)\n• Storage Socket: Standard M.2 Key-M (TE 2199119-4)\n• Form Factors: Supports M.2 2242 & 2280 NVMe SSDs\n• Throughput: ~400 MB/s (10x Faster Than MicroSD)\n• Diagnostics: Green NVMe Drive Read/Write LED"
		(exclude_from_sim no)
		(at 198 102 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "11111111-0001-0001-0001-000000000008")
	)
	(text "HARDWARE SPECIFICATIONS & LAYER STACKUP SUMMARY\n-----------------------------------------------------------------------------------------------------------------------------------\n• Target Form Factor: ~90 mm x 60 mm Mini-ITX Compact Carrier\n• PCB Architecture: 4-Layer Controlled-Impedance (JLCPCB JLC04161H Stackup)\n• Layer Allocation: L1 (High-Speed Signals) / L2 (Solid GND Plane) / L3 (Power Planes) / L4 (Signals & Power)\n• Primary OS Boot: Direct NVMe Solid-State Drive Boot (Raspberry Pi OS / RetroPie / Ubuntu)\n• Secondary Boot: MicroSD Card Interface for Recovery / CM4 Lite Provisioning"
		(exclude_from_sim no)
		(at 100 152 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "11111111-0001-0001-0001-000000000009")
	)
